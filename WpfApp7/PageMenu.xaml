<Page x:Class="WpfApp7.PageMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp7"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageMenu">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Выберите страницу:" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <!-- Подсказки (ToolTip) -->
        <Button Content="Страница рисования" Width="200" Height="40" Margin="10" 
                Click="BtnDraw_Click" ToolTip="Перейти к холсту для рисования линий"/>
        <Button Content="Настройки (Текст)" Width="200" Height="40" Margin="10" 
                Click="BtnSettings_Click" ToolTip="Перейти к сохранению текста"/>
        <Button Content="Галерея" Width="200" Height="40" Margin="10" 
                Click="BtnGallery_Click" ToolTip="Посмотреть картинки морских котиков"/>
    </StackPanel>
</Page>
