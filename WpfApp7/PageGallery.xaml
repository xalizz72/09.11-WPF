<Page x:Class="WpfApp7.PageGallery"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp7"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageGallery">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кнопка возврата в меню -->
        <Button Content="Назад в меню" Width="150" Height="35" HorizontalAlignment="Left" 
                Margin="10" Click="GoToMenu_Click" ToolTip="Вернуться на главную страницу"/>

        <!-- ListBox с картинками -->
        <ListBox x:Name="ImagesList" Grid.Row="1" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Вот тут магия: WrapPanel выстраивает элементы в ряд с переносом -->
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!-- Шаблон того, как выглядит один элемент списка -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding}" Width="200" Height="150" Margin="10" Stretch="UniformToFill"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
